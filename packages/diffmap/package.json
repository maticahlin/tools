{
  "name": "diffmaps",
  "version": "0.1.0",
  "description": "A difference-blend cursor whose colors you control. Text, images and video, every major browser.",
  "type": "module",
  "license": "MIT",
  "author": "Matic Ahlin (https://tools.maticahlin.com)",
  "homepage": "https://tools.maticahlin.com/diffmaps",
  "keywords": [
    "cursor",
    "mix-blend-mode",
    "difference",
    "gradient map",
    "duotone",
    "hover effect"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "browser": "./dist/diffmap.min.js",
      "default": "./src/index.js"
    },
    "./core": {
      "types": "./src/core.d.ts",
      "default": "./src/core.js"
    },
    "./dist/*": "./dist/*"
  },
  "main": "./src/index.js",
  "bin": {
    "diffmaps": "bin/diffmap.js",
    "diffmap": "bin/diffmap.js"
  },
  "files": [
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "agents",
    "bin",
    "dist",
    "setup/dusk.jpg",
    "setup/index.html",
    "setup/temeraire.jpg",
    "src"
  ],
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "test:pixel": "node test/pixel.mjs chromium webkit firefox",
    "test:pilot": "node test/pilot.mjs chromium webkit firefox",
    "bench": "node test/bench.mjs chromium",
    "prepublishOnly": "npm run build && npm test"
  },
  "types": "./src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maticahlin/tools.git",
    "directory": "packages/diffmap"
  },
  "bugs": {
    "url": "https://github.com/maticahlin/tools/issues"
  }
}
